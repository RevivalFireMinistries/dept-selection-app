# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dptselection"

# Or use individual variables (Railway style)
# PGHOST=localhost
# PGDATABASE=dptselection
# PGUSER=postgres
# PGPASSWORD=password
# PGPORT=5432


# ─── rfm-database (central member directory) integration ────────────────────
# When enabled, member personal info (name, phone, email, address) is sourced
# from the central rfm-database service instead of from the local table.
# Auth, leadership_roles, and selection-app data stay local.
#
# Toggle this off to instantly revert to legacy local-only behaviour.
RFM_API_INTEGRATION_ENABLED="false"

# URL of the running rfm-database service (no trailing slash)
RFM_API_URL="https://rfm-db-api.up.railway.app"

# Service API key with member read+write scope (set in the rfm-database
# admin UI under "API Keys"). Sent as the X-API-Key header on every request.
RFM_API_KEY=""

# How long to trust cached member data before re-fetching from the API
# (default 86400 = 24h). Lower = fresher reads, higher = less API load.
RFM_API_TTL_SECONDS="86400"

# HTTP timeout per API call in seconds (default 8). Keep this low so a slow
# API doesn't hang the portal.
RFM_API_TIMEOUT_SECONDS="8"
